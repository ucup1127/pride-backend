generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  role      String     @default("user")
  orders    Order[]
  undangan  Undangan[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([phone, code])
}

model Template {
  id       String @id
  name     String
  style    String
  category String
  tag      String
  event    String
  names    String
  date     String
  bg       String
  fg       String
  undangan Undangan[]
}

model Order {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               String?
  templateId         String?
  amount             Int        @default(0)
  publishedCount     Int        @default(0)
  paymentMethod      String?
  contactPhone       String?
  transferAmount     Int?
  transferSenderName String?
  transferReference  String?
  transferDate       DateTime?
  status             String     @default("pending")
  expiresAt          DateTime?
  paidAt             DateTime?
  reviewedAt         DateTime?
  reviewedBy         String?
  refundAmount       Int?
  adminFee           Int?
  reviewNote         String?
  undangan           Undangan[]
  createdAt          DateTime   @default(now())

  @@index([userId, status, createdAt])
}

model Undangan {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  templateId String
  template   Template @relation(fields: [templateId], references: [id])
  judul      String
  slug       String   @unique
  isPublic   Boolean  @default(false)
  data       Json?
  status     String   @default("draft")
  publishedAt DateTime?
  expiresAt  DateTime?
  rsvp       Rsvp[]
  guests     Guest[]
  wishes     Wish[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderId])
}

model Rsvp {
  id         String   @id @default(cuid())
  undanganId String
  undangan   Undangan @relation(fields: [undanganId], references: [id], onDelete: Cascade)
  nama       String
  kehadiran  String
  jumlah     Int      @default(1)
  ucapan     String?
  createdAt  DateTime @default(now())
}

model Guest {
  id         String   @id @default(cuid())
  undanganId String
  undangan   Undangan @relation(fields: [undanganId], references: [id], onDelete: Cascade)
  nama       String
  slug       String   @unique
  kategori   String?  // keluarga | teman | kerja | vip
  telepon    String?
  jumlah     Int      @default(1)
  status     String   @default("pending") // pending | hadir | tidak_hadir | ragu
  catatan    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([undanganId])
}

model Wish {
  id         String   @id @default(cuid())
  undanganId String
  undangan   Undangan @relation(fields: [undanganId], references: [id], onDelete: Cascade)
  nama       String
  kehadiran  String   // hadir | tidak_hadir | ragu
  ucapan     String
  createdAt  DateTime @default(now())
}